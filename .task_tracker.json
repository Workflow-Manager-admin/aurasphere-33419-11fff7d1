{
  "task_description": "{'component_name': 'Main Container for AuraSphere', 'description': 'Primary container for AuraSphere implementation: MyAuraGram is a full-stack social media platform inspired by Instagram, designed as a digital aura space where users express their moods and energy through posts. Users can sign up (email/Google), create/edit profiles, upload images/videos, interact with posts (like, comment, save), follow/unfollow, receive real-time notifications, explore trending content, share stories, direct message, and toggle dark/light mode. The app features an admin dashboard, responsive design, and aesthetic UI with animations. Built with React.js/Next.js, Tailwind CSS, and Firebase/Supabase/MongoDB, it ensures secure, performant, and private user experiences. Optional features include audio reels, profile themes, mood-based filters, AI captions, color palettes, and post scheduling.', 'framework': 'express', 'platform': 'web', 'container': '{\n  "name": "ColorCraft backend Container",\n  "features": [\n    {\n      "name": "User Authentication",\n      "description": "Sign up and log in with email or Google authentication using Firebase Auth or Auth0.",\n      "isEnabled": true\n    },\n    {\n      "name": "Profile Management",\n      "description": "Create and edit user profiles with bio, avatar, and username.",\n      "isEnabled": true\n    },\n    {\n      "name": "Media Uploads",\n      "description": "Upload images and short videos with captions and hashtags, stored via Cloudinary or Firebase Storage.",\n      "isEnabled": true\n    },\n    {\n      "name": "Feed",\n      "description": "Scrollable feed of posts from followed users, with vibey design and smooth transitions.",\n      "isEnabled": true\n    },\n    {\n      "name": "Post Interactions",\n      "description": "Like, comment, and save posts; real-time updates for interactions.",\n      "isEnabled": true\n    },\n    {\n      "name": "Follow System",\n      "description": "Follow and unfollow other users to curate your feed.",\n      "isEnabled": true\n    },\n    {\n      "name": "Notifications",\n      "description": "Real-time notifications for likes, comments, and follows using Socket.io or Firebase Realtime DB.",\n      "isEnabled": true\n    },\n    {\n      "name": "Explore Page",\n      "description": "Discover trending content and hashtags on a dedicated explore page.",\n      "isEnabled": true\n    },\n    {\n      "name": "Stories",\n      "description": "24-hour disappearing content (stories) feature.",\n      "isEnabled": true\n    },\n    {\n      "name": "Direct Messaging",\n      "description": "1-on-1 chat with media sharing, powered by real-time backend.",\n      "isEnabled": true\n    },\n    {\n      "name": "Dark/Light Mode",\n      "description": "Toggle between dark and light UI themes.",\n      "isEnabled": true\n    },\n    {\n      "name": "Admin Dashboard",\n      "description": "Admin tools to monitor reports and flagged content.",\n      "isEnabled": true\n    },\n    {\n      "name": "Responsive UI/UX",\n      "description": "Optimized for both mobile and desktop with animations and smooth transitions.",\n      "isEnabled": true\n    },\n    {\n      "name": "Audio Reels",\n      "description": "Create and share short audio reels (optional feature).",\n      "isEnabled": true\n    },\n    {\n      "name": "Profile Themes",\n      "description": "Users can customize their profile with themes and color palettes (optional feature).",\n      "isEnabled": true\n    },\n    {\n      "name": "Mood-based Filters",\n      "description": "Suggest filters based on user mood or aura (optional feature).",\n      "isEnabled": true\n    },\n    {\n      "name": "AI-generated Captions/Hashtags",\n      "description": "AI suggests captions or hashtags for posts (optional feature).",\n      "isEnabled": true\n    },\n    {\n      "name": "Post Scheduling",\n      "description": "Schedule posts to be published at a later time (optional feature).",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "None"\n    ],\n    "backend": [\n      "Express.js"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#0c57a7",\n    "secondary": "#ededed",\n    "accent": "#000000"\n  },\n  "theme": "dark",\n  "layoutDescription": "The UI features a modern, responsive layout with a top navigation bar (logo, search, notifications, profile menu), a left sidebar (navigation links), and a main feed area. The feed displays posts as cards with smooth hover effects and animated transitions. Stories appear as a horizontal carousel at the top. The explore page uses a grid layout for trending content. Direct messages open in a chat drawer or modal. Profile pages are customizable with color themes. Admin dashboard is accessible via a separate route. Dark/light mode toggle is available in the settings menu. All components are optimized for mobile and desktop."\n}'}",
